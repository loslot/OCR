# Root .gitignore for QuickOCR Project

# Dependencies
node_modules/
.pnp
.pnp.js

# Production / Next.js builds
.next/
out/
build/
dist/

# Python / Virtual Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets (Keep .env.example committed)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Storage contents (preserve directories with .gitkeep)
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/results/*
!backend/storage/results/.gitkeep

# IDEs & OS Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
